# FabFlow AI — Environment Variable Reference
# Copy to .env and fill in real values

# Database
DATABASE_URL=postgresql://fabflow_user:fabflow_secret@localhost:5432/fabflow_db

# Set to "true" to echo all SQL queries in logs (dev only)
SQL_ECHO=false

# Connection pool settings (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
